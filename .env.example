# Copy to .env (never commit .env). Everything is optional for local/basic mode except what is marked REQUIRED in production.
PHISHGUARD_ENV=development            # set to "production" when deployed
JWT_SECRET=                           # REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                       # REQUIRED in production (>=12 chars, mixed case, a digit)
ADMIN_MASTER_KEY=                     # Vault second factor (>=16 chars). Leave empty to disable the Admin Vault.
VAULT_SESSION_MINUTES=10
DATABASE_PATH=database/phishguard.db
GOOGLE_SAFE_BROWSING_API_KEY=         # optional, free: console.cloud.google.com -> Safe Browsing API
URLHAUS_AUTH_KEY=                     # optional, free: https://auth.abuse.ch/
ENABLE_NETWORK_CHECKS=true            # false = fully offline (ML + rules only)
CORS_ORIGINS=                         # comma separated; leave empty (the dashboard is served by the backend)
RATE_LIMIT_SCAN_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RETENTION_DAYS=90
TRUST_PROXY_HEADERS=false             # true only behind a trusted reverse proxy (Render, Fly, nginx)
